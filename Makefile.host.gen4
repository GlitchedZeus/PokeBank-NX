# G4-01: shared PK4 + strict read-only Gen IV parser gates.
GEN4_FOUNDATION_SOURCES := tests/test_gen4_readonly_foundation.cpp \
	src/Integration/Gen4/Gen4ReadOnlySave.cpp \
	src/Pokemon/Pokemon4ReadOnly.cpp src/Pokemon/Pokemon4ReadOnlyView.cpp src/Pokemon/PersonalRecord4.cpp \
	src/Pokemon/PersonalInfo4DP.cpp src/Pokemon/PersonalInfo4PT.cpp src/Pokemon/PersonalInfo4HGSS.cpp \
	src/Encryption/Encryption4.cpp src/Utils/SHA256.cpp \
	src/Integration/Gen4/Gen4AssignedSource.cpp src/Integration/Gen4/Gen4SourceDiscovery.cpp \
	src/Legacy/LegacySourceBindings.cpp src/Legacy/Gen4ReadOnlyTrainer.cpp \
	src/Pokemon/Experience.cpp src/Names/SpeciesNames.cpp \
	src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp \
	vendor/PKSM-Core/source/utils/crypto_checksums.cpp

GEN4_TEST := $(HOST_BUILD)/test_gen4_readonly_foundation
GEN4_SANITIZE := $(HOST_BUILD)/test_gen4_readonly_foundation_sanitize

HOST_TESTS += $(GEN4_TEST)
HOST_SANITIZE_TESTS += $(GEN4_SANITIZE)
host-test: $(GEN4_TEST)
host-sanitize: $(GEN4_SANITIZE)

GEN4_HEADERS := $(wildcard include/Integration/Gen4/*.h include/Pokemon/*4*.h include/Utils/Gen4*.h) include/Encryption/Encryption4.h include/Legacy/LegacySourceBindings.h include/Integration/Gen4/Gen4SourceDiscovery.h

$(GEN4_TEST): $(GEN4_FOUNDATION_SOURCES) $(GEN4_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Wno-unused-parameter -Iinclude -Ivendor/PKSM-Core/include $(GEN4_FOUNDATION_SOURCES) -o $@

$(GEN4_SANITIZE): $(GEN4_FOUNDATION_SOURCES) $(GEN4_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -Iinclude -Ivendor/PKSM-Core/include $(GEN4_FOUNDATION_SOURCES) -o $@

.PHONY: gen4-safety-contract
gen4-safety-contract:
	python3 tests/test_gen4_safety_contract.py
host-test: gen4-safety-contract
host-sanitize: gen4-safety-contract


# G4-03: exact Gen IV adapter contract for the one shared Pokemon editor shell.
GEN4_EDITOR_PROVIDER_TEST := $(HOST_BUILD)/test_gen4_exact_format_editor_provider
GEN4_EDITOR_PROVIDER_SANITIZE := $(HOST_BUILD)/test_gen4_exact_format_editor_provider_sanitize

HOST_TESTS += $(GEN4_EDITOR_PROVIDER_TEST)
HOST_SANITIZE_TESTS += $(GEN4_EDITOR_PROVIDER_SANITIZE)
host-test: $(GEN4_EDITOR_PROVIDER_TEST)
host-sanitize: $(GEN4_EDITOR_PROVIDER_SANITIZE)

$(GEN4_EDITOR_PROVIDER_TEST): tests/test_gen4_exact_format_editor_provider.cpp \
	include/Integration/Gen4/Gen4ExactFormatEditorProvider.h \
	include/UI/ExactFormatEditorProvider.h include/UI/ExactSaveCapabilities.h \
	include/UI/SharedPokemonEditorContract.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $< -o $@

$(GEN4_EDITOR_PROVIDER_SANITIZE): tests/test_gen4_exact_format_editor_provider.cpp \
	include/Integration/Gen4/Gen4ExactFormatEditorProvider.h \
	include/UI/ExactFormatEditorProvider.h include/UI/ExactSaveCapabilities.h \
	include/UI/SharedPokemonEditorContract.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $< -o $@
