# G4-01: shared PK4 + strict read-only Gen IV parser gates.
GEN4_FOUNDATION_SOURCES := tests/test_gen4_readonly_foundation.cpp \
	src/Integration/Gen4/Gen4ReadOnlySave.cpp \
	src/Pokemon/Pokemon4ReadOnly.cpp src/Pokemon/PersonalRecord4.cpp \
	src/Pokemon/PersonalInfo4DP.cpp src/Pokemon/PersonalInfo4PT.cpp src/Pokemon/PersonalInfo4HGSS.cpp \
	src/Encryption/Encryption4.cpp

GEN4_TEST := $(HOST_BUILD)/test_gen4_readonly_foundation
GEN4_SANITIZE := $(HOST_BUILD)/test_gen4_readonly_foundation_sanitize

HOST_TESTS += $(GEN4_TEST)
HOST_SANITIZE_TESTS += $(GEN4_SANITIZE)
host-test: $(GEN4_TEST)
host-sanitize: $(GEN4_SANITIZE)

$(GEN4_TEST): $(GEN4_FOUNDATION_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(GEN4_FOUNDATION_SOURCES) -o $@

$(GEN4_SANITIZE): $(GEN4_FOUNDATION_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN4_FOUNDATION_SOURCES) -o $@
