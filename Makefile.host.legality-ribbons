# Focused persisted Gen III Event3 ribbon-reader regression.
# Reuse the already-proven Gen III legality link graph, replacing its test main.
GEN3_EVENT_RIBBON_BITS_SOURCES := tests/test_gen3_event_ribbon_bits.cpp \
	$(filter-out tests/test_gen3_legality_context.cpp,$(GEN3_LEGALITY_CONTEXT_SOURCES))

GEN3_EVENT_RIBBON_BITS_HOST_TESTS := $(HOST_BUILD)/test_gen3_event_ribbon_bits
GEN3_EVENT_RIBBON_BITS_SANITIZE_TESTS := $(HOST_BUILD)/test_gen3_event_ribbon_bits_sanitize

HOST_TESTS += $(GEN3_EVENT_RIBBON_BITS_HOST_TESTS)
HOST_SANITIZE_TESTS += $(GEN3_EVENT_RIBBON_BITS_SANITIZE_TESTS)
host-test: $(GEN3_EVENT_RIBBON_BITS_HOST_TESTS)
host-sanitize: $(GEN3_EVENT_RIBBON_BITS_SANITIZE_TESTS)

$(HOST_BUILD)/test_gen3_event_ribbon_bits: $(GEN3_EVENT_RIBBON_BITS_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN3_LEGALITY_CONTEXT_FLAGS) -Iinclude $^ -o $@

$(HOST_BUILD)/test_gen3_event_ribbon_bits_sanitize: $(GEN3_EVENT_RIBBON_BITS_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN3_LEGALITY_CONTEXT_FLAGS) $(SANITIZE_FLAGS) -Iinclude $^ -o $@
