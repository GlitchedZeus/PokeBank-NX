CXX ?= g++
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Wpedantic -Werror -O2
SANITIZE_FLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer -O1

HOST_BUILD := build-host
HOST_TEST := $(HOST_BUILD)/test_game_identity
HOST_SANITIZE_TEST := $(HOST_BUILD)/test_game_identity_sanitize
HOST_SOURCES := tests/test_game_identity.cpp src/Games/GameIdentity.cpp

.PHONY: host-test host-sanitize host-clean

host-test: $(HOST_TEST)
	./$(HOST_TEST)

host-sanitize: $(HOST_SANITIZE_TEST)
	# LeakSanitizer cannot inspect /proc under the managed build sandbox. AddressSanitizer and
	# UndefinedBehaviorSanitizer still run; leak checks remain enabled in unrestricted CI builds.
	ASAN_OPTIONS=detect_leaks=0 ./$(HOST_SANITIZE_TEST)

$(HOST_TEST): $(HOST_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(HOST_SOURCES) -o $@

$(HOST_SANITIZE_TEST): $(HOST_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $(HOST_SOURCES) -o $@

host-clean:
	rm -rf $(HOST_BUILD)
