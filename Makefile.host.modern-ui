MODERN_UI_SANITIZE_TESTS += $(MODERN_UI_GEN8_SANITIZE)
# The same surface over the BD/SP adapter and a synthetic SAV8BS SaveData fixture.
MODERN_UI_GEN8B_TEST := $(HOST_BUILD)/test_ui_modern_surface_gen8b_host
MODERN_UI_GEN8B_SANITIZE := $(HOST_BUILD)/test_ui_modern_surface_gen8b_host_sanitize
