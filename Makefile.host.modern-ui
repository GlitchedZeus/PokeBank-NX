	$(CXX) $(CXXFLAGS) $(MODERN_UI_SURFACE_FLAGS) tests/test_ui_modern_surface_gen8b_host.cpp $(MODERN_UI_STUBS) $(MODERN_UI_ARCHIVE) -o $@
$(MODERN_UI_GEN8B_SANITIZE): $(MODERN_UI_GEN8B_INPUTS) $(MODERN_UI_SANITIZE_ARCHIVE)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) $(MODERN_UI_SURFACE_FLAGS) tests/test_ui_modern_surface_gen8b_host.cpp $(MODERN_UI_STUBS) $(MODERN_UI_SANITIZE_ARCHIVE) -o $@
