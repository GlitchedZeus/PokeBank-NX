	src/UI/ModernSharedSurface.inc $(MODERN_UI_STUBS)
HOST_TESTS += $(MODERN_UI_GEN8B_TEST)
HOST_SANITIZE_TESTS += $(MODERN_UI_GEN8B_SANITIZE)
