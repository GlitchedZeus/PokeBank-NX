.PHONY: modern-ui-host-test modern-ui-host-sanitize
modern-ui-host-test: $(MODERN_UI_TESTS)
	@set -e; for test_bin in $(MODERN_UI_TESTS); do ./$$test_bin; done
modern-ui-host-sanitize: $(MODERN_UI_SANITIZE_TESTS)
	@set -e; for test_bin in $(MODERN_UI_SANITIZE_TESTS); do ASAN_OPTIONS="$(ASAN_OPTIONS)" ./$$test_bin; done
