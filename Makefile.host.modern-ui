$(MODERN_UI_GEN7_SANITIZE): $(MODERN_UI_GEN7_INPUTS) $(MODERN_UI_SANITIZE_ARCHIVE)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) $(MODERN_UI_SURFACE_FLAGS) tests/test_ui_modern_surface_gen7_host.cpp $(MODERN_UI_STUBS) $(MODERN_UI_SANITIZE_ARCHIVE) -o $@
MODERN_UI_TESTS += $(MODERN_UI_GEN7_TEST)
MODERN_UI_SANITIZE_TESTS += $(MODERN_UI_GEN7_SANITIZE)
# The same surface over the Sword/Shield adapter and a synthetic SwishCrypto `main` fixture.
MODERN_UI_GEN8_TEST := $(HOST_BUILD)/test_ui_modern_surface_gen8_host
