# Focused Gen III-IV language-domain legality regressions.
GEN34_LANGUAGE_SOURCES := tests/test_gen34_language_evidence.cpp
GEN34_LANGUAGE_HEADERS := include/Legality/Gen34LanguageEvidence.h
GEN34_LANGUAGE_PK4_HEADERS := include/Pokemon/Pokemon4ReadOnly.h \
	include/Pokemon/Pokemon4ReadOnlyView.h include/Encryption/Encryption4.h
GEN34_LANGUAGE_ANALYZER_SOURCES := tests/test_gen34_language_analyzer.cpp \
	$(filter-out tests/test_gen3_legality_context.cpp,$(GEN3_LEGALITY_CONTEXT_SOURCES)) \
	src/Pokemon/Pokemon4ReadOnly.cpp src/Pokemon/Pokemon4ReadOnlyView.cpp \
	src/Encryption/Encryption4.cpp

HOST_TESTS += $(HOST_BUILD)/test_gen34_language_evidence
HOST_TESTS += $(HOST_BUILD)/test_gen34_language_analyzer
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen34_language_evidence_sanitize
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen34_language_analyzer_sanitize
host-test: $(HOST_BUILD)/test_gen34_language_evidence $(HOST_BUILD)/test_gen34_language_analyzer
host-sanitize: $(HOST_BUILD)/test_gen34_language_evidence_sanitize $(HOST_BUILD)/test_gen34_language_analyzer_sanitize

$(HOST_BUILD)/test_gen34_language_evidence: $(GEN34_LANGUAGE_SOURCES) $(GEN34_LANGUAGE_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(GEN34_LANGUAGE_SOURCES) -o $@

$(HOST_BUILD)/test_gen34_language_evidence_sanitize: $(GEN34_LANGUAGE_SOURCES) $(GEN34_LANGUAGE_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN34_LANGUAGE_SOURCES) -o $@

$(HOST_BUILD)/test_gen34_language_analyzer: $(GEN34_LANGUAGE_ANALYZER_SOURCES) $(GEN34_LANGUAGE_HEADERS) $(GEN34_LANGUAGE_PK4_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN3_LEGALITY_CONTEXT_FLAGS) -Iinclude $(GEN34_LANGUAGE_ANALYZER_SOURCES) -o $@

$(HOST_BUILD)/test_gen34_language_analyzer_sanitize: $(GEN34_LANGUAGE_ANALYZER_SOURCES) $(GEN34_LANGUAGE_HEADERS) $(GEN34_LANGUAGE_PK4_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN3_LEGALITY_CONTEXT_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN34_LANGUAGE_ANALYZER_SOURCES) -o $@

GEN3_BERRY_CONTEXT_SOURCES := tests/test_gen3_berry_context.cpp $(filter-out tests/test_gen3_legality_context.cpp,$(GEN3_LEGALITY_CONTEXT_SOURCES))
HOST_TESTS += $(HOST_BUILD)/test_gen3_berry_context
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_berry_context_sanitize
host-test: $(HOST_BUILD)/test_gen3_berry_context
host-sanitize: $(HOST_BUILD)/test_gen3_berry_context_sanitize
$(HOST_BUILD)/test_gen3_berry_context: $(GEN3_BERRY_CONTEXT_SOURCES) include/Legality/Gen3BerryContext.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Wno-unused-parameter -Iinclude $(GEN3_BERRY_CONTEXT_SOURCES) -o $@
$(HOST_BUILD)/test_gen3_berry_context_sanitize: $(GEN3_BERRY_CONTEXT_SOURCES) include/Legality/Gen3BerryContext.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -Iinclude $(GEN3_BERRY_CONTEXT_SOURCES) -o $@

HOST_TESTS += $(HOST_BUILD)/test_legality_report_presentation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_report_presentation_sanitize
host-test: $(HOST_BUILD)/test_legality_report_presentation
