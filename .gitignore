# Ignore build output
/build/
/build-host/
/build-deps/
/dist-device/
/*.elf
/*.nro
/*.nsp
/*.nacp
/*.lst
/*.map
/*.npdm
/*.nso

# Ignore VS Code settings
/.vscode/

# Ignore VS settings
/.vs/
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore log files
*.log
PKSE.log
debug.log

# Ignore temporary files
*.tmp
*.bak
*.swp
*.swo
*.DS_Store

# Ignore compiler-generated files
*.o
*.d
*.a

# Ignore dependency-specific files
/dependencies/
/libs/

# Ignore ROMFS and data directories if generated dynamically
/romfs/
/data/

# Python cache from the code-generator scripts in tools/
tools/__pycache__/
# PKHeX source/resource files the gen_*.py scripts fetch from GitHub (tools/pkhex_source.py)
tools/.pkhex_cache/
tools/.pret_cache/

# Return host build outputs (built by make into romfs/runtime)
/runtime/return_host/build/
/runtime/return_host/*.elf
/runtime/return_host/*.nacp
/runtime/return_host/*.nro
/romfs/runtime/
/romfs/game_cards/
__pycache__/
