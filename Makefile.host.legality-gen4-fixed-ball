# Focused Gen IV source-proven fixed-ball evidence regressions.
GEN4_FIXED_BALL_SOURCES := tests/test_gen4_fixed_ball_evidence.cpp
GEN4_FIXED_BALL_HEADERS := include/Legality/Gen4FixedBallEvidence.h include/Legality/Gen4WildEncounter.h include/Legality/Gen4WildEncounterData.inc

HOST_TESTS += $(HOST_BUILD)/test_gen4_fixed_ball_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_fixed_ball_evidence_sanitize
host-test: $(HOST_BUILD)/test_gen4_fixed_ball_evidence
host-sanitize: $(HOST_BUILD)/test_gen4_fixed_ball_evidence_sanitize

$(HOST_BUILD)/test_gen4_fixed_ball_evidence: $(GEN4_FIXED_BALL_SOURCES) $(GEN4_FIXED_BALL_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(GEN4_FIXED_BALL_SOURCES) -o $@

$(HOST_BUILD)/test_gen4_fixed_ball_evidence_sanitize: $(GEN4_FIXED_BALL_SOURCES) $(GEN4_FIXED_BALL_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN4_FIXED_BALL_SOURCES) -o $@
