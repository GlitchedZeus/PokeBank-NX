$(HOST_BUILD)/test_gen1_pokemon_editor_ux3_contract_sanitize: $(GEN1_CLEANUP3_UX_SOURCES) include/UI/Gen1PokemonEditorUX3Contract.h include/UI/NavigationRepeat.h
