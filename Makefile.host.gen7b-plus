# Let's Go Pikachu / Eevee (SAV7b / PB7) adapter of the shared Modern::NativeSession contract
# (development/gen6-plus). Host tests only; exports go to a fresh temporary directory.
GEN7BPLUS_TEST_NAMES := test_gen7b_native_session
GEN7BPLUS_TESTS := $(addprefix $(HOST_BUILD)/,$(GEN7BPLUS_TEST_NAMES))
GEN7BPLUS_SANITIZE_TESTS := $(addsuffix _sanitize,$(GEN7BPLUS_TESTS))

HOST_TESTS += $(GEN7BPLUS_TESTS)
HOST_SANITIZE_TESTS += $(GEN7BPLUS_SANITIZE_TESTS)
host-test: $(GEN7BPLUS_TESTS)
host-sanitize: $(GEN7BPLUS_SANITIZE_TESTS)

GEN7BPLUS_HEADERS := $(wildcard include/Integration/Gen7b/*.h) $(wildcard tests/fixtures/gen7b/*.h) \
	$(wildcard tests/fixtures/gen6/*.h) include/Integration/Gen6/Gen6PK6.h include/Save/LGPEReadValidation.h \
	include/Integration/Common/GameCapabilityRegistry.h include/Integration/Modern/NativeSession.h
GEN7BPLUS_FLAGS := -Wno-unused-parameter -Iinclude -Itests -D_PKSMCORE_CONFIGURED -fno-operator-names
GEN7BPLUS_SESSION_SOURCES := src/Integration/Gen7b/Gen7bNativeSession.cpp src/Integration/Gen7b/Gen7bStagedSession.cpp \
	src/Integration/Gen7b/Gen7bSave.cpp src/Integration/Common/VerifiedStagedExport.cpp src/Utils/SHA256.cpp \
	src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp src/Pokemon/PokemonTypes.cpp src/Pokemon/PersonalInfoTable.cpp
GEN7BPLUS_SOURCES_test_gen7b_native_session := tests/test_gen7b_native_session.cpp $(GEN7BPLUS_SESSION_SOURCES)

define GEN7BPLUS_TEST_RULES
$(HOST_BUILD)/$(1): $$(GEN7BPLUS_SOURCES_$(1)) $$(GEN7BPLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(GEN7BPLUS_FLAGS) $$(GEN7BPLUS_SOURCES_$(1)) -o $$@

$(HOST_BUILD)/$(1)_sanitize: $$(GEN7BPLUS_SOURCES_$(1)) $$(GEN7BPLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(SANITIZE_FLAGS) $$(GEN7BPLUS_FLAGS) $$(GEN7BPLUS_SOURCES_$(1)) -o $$@
endef
$(foreach t,$(GEN7BPLUS_TEST_NAMES),$(eval $(call GEN7BPLUS_TEST_RULES,$(t))))

.PHONY: gen7bplus-host-test gen7bplus-host-sanitize
gen7bplus-host-test: $(GEN7BPLUS_TESTS)
	@set -e; for test_bin in $(GEN7BPLUS_TESTS); do ./$$test_bin; done

gen7bplus-host-sanitize: $(GEN7BPLUS_SANITIZE_TESTS)
	@set -e; for test_bin in $(GEN7BPLUS_SANITIZE_TESTS); do ASAN_OPTIONS="$(ASAN_OPTIONS)" ./$$test_bin; done
