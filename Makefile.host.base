CXX ?= g++
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Wpedantic -Werror -O2
SANITIZE_FLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer -O1

HOST_BUILD := build-host
HOST_TESTS := $(HOST_BUILD)/test_game_identity $(HOST_BUILD)/test_write_policy $(HOST_BUILD)/test_action_sheet_model $(HOST_BUILD)/test_theme $(HOST_BUILD)/test_navigation_repeat $(HOST_BUILD)/test_controller_model $(HOST_BUILD)/test_sprite_layout
HOST_SANITIZE_TESTS := $(HOST_BUILD)/test_game_identity_sanitize $(HOST_BUILD)/test_write_policy_sanitize $(HOST_BUILD)/test_action_sheet_model_sanitize $(HOST_BUILD)/test_theme_sanitize $(HOST_BUILD)/test_navigation_repeat_sanitize $(HOST_BUILD)/test_controller_model_sanitize $(HOST_BUILD)/test_sprite_layout_sanitize
HOST_TESTS += $(HOST_BUILD)/test_source_mutation_policy $(HOST_BUILD)/test_pla_read_validation \
	$(HOST_BUILD)/test_gen3_party_record
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_source_mutation_policy_sanitize $(HOST_BUILD)/test_pla_read_validation_sanitize \
	$(HOST_BUILD)/test_gen3_party_record_sanitize
PLA_TEST_SOURCES := tests/test_pla_read_validation.cpp src/Save/Block.cpp src/Encryption/Encryption.cpp src/Encryption/Encryption8LA.cpp src/Enums/SCTypeCode.cpp src/Utils/HelperUtilities.cpp src/Utils/StringHelpers.cpp src/Utils/SHA256.cpp src/Utils/ReadAllBytes.cpp
PKSM_CORE_ROOT := vendor/PKSM-Core
PKSM_CORE_SOURCES := $(shell find $(PKSM_CORE_ROOT)/source $(PKSM_CORE_ROOT)/memecrypto -type f \( -name '*.cpp' -o -name '*.c' \) -print)
PKSM_CORE_INCLUDES := $(shell find $(PKSM_CORE_ROOT)/include $(PKSM_CORE_ROOT)/memecrypto $(PKSM_CORE_ROOT)/pcg-cpp -type d -printf ' -I%p')
PKSM_CORE_DEFINES := -D_PKSMCORE_CONFIGURED \
	-D_PKSMCORE_LANG_FOLDER='"$(PKSM_CORE_ROOT)/strings/"' \
	-D_PKSMCORE_PERSONAL_FOLDER='"$(PKSM_CORE_ROOT)/personals/"'
PKSM_CORE_FLAGS := -fno-operator-names -Wno-psabi \
	-Wno-missing-field-initializers -Wno-unused-parameter
GEN3_ADAPTER_SOURCES := tests/test_pksm_gen3_adapter.cpp \
	src/Integration/Gen3/PKSMGen3Adapter.cpp src/Integration/Gen3/FRLGReadModel.cpp \
	src/Encryption/Encryption3FRLG.cpp src/Utils/StringHelpers.cpp \
	src/Utils/HelperUtilities.cpp \
	src/Utils/SHA256.cpp
GEN3_NATIVE_SLICE_SOURCES := tests/test_pksm_gen3_adapter.cpp \
	src/Integration/Gen3/PKSMGen3NativeAdapter.cpp src/Integration/Gen3/FRLGReadModel.cpp \
	src/Encryption/Encryption3FRLG.cpp \
	src/Names/ItemNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp \
	src/Utils/SHA256.cpp
# Runtime legacy discovery now appends separately validated Gen I R/B/Y sources. The accepted Gen III
# scanner remains unchanged; these are link dependencies for its configured runtime catalog wrapper.
RBY_RUNTIME_DISCOVERY_SOURCES := src/Legacy/RetroArchRBYDiscovery.cpp \
	src/Integration/Gen1/Gen1ReadOnlySave.cpp
RETROARCH_FRLG_SOURCES := tests/test_retroarch_frlg_discovery.cpp \
	src/Legacy/RetroArchFRLGDiscovery.cpp $(RBY_RUNTIME_DISCOVERY_SOURCES) \
	src/Integration/Gen3/PKSMGen3NativeAdapter.cpp \
	src/Integration/Gen3/FRLGReadModel.cpp \
	src/Encryption/Encryption3FRLG.cpp src/Names/ItemNames.cpp src/Utils/StringHelpers.cpp \
	src/Utils/HelperUtilities.cpp src/Utils/SHA256.cpp src/Games/GameIdentity.cpp
# Trainers with staged classic-inventory sidecars pull these implementation dependencies into
# every host executable that instantiates them. ItemNames.cpp is already present in both trainer
# source groups below, so this list intentionally contains only the additional shared catalog pieces.
CLASSIC_INVENTORY_CATALOG_LINK_SOURCES := src/Inventory/ClassicInventoryCatalog.cpp \
	src/Names/MoveNames.cpp src/Integration/Gen2/Gen2ReadOnlyInventory.cpp
GEN3_STAGED_INVENTORY_LINK_SOURCES := src/Integration/Gen3/Gen3StagedInventoryEditor.cpp \
	$(CLASSIC_INVENTORY_CATALOG_LINK_SOURCES)
GEN3_STAGED_POKEMON_LINK_SOURCES := src/Integration/Gen3/Gen3StagedPokemonEditor.cpp \
	src/Names/MoveInfo.cpp
GEN3_LEGALITY_CONTEXT_SOURCES := tests/test_gen3_legality_context.cpp \
	src/Legality/Legality.cpp \
	src/Integration/Gen1/Gen1MoveCompatibility.cpp \
	src/Integration/Gen2/Gen2MoveCompatibility.cpp \
	src/Pokemon/Pokemon3FRLG.cpp src/Encryption/Encryption3FRLG.cpp \
	src/Pokemon/BaseStatsGen89.cpp src/Pokemon/PersonalInfoTable.cpp src/Pokemon/Experience.cpp \
	src/Pokemon/AbilityInfo.cpp src/Pokemon/FormInfo.cpp src/Pokemon/LearnsetTable.cpp \
	src/Names/MoveNames.cpp src/Names/ItemNames.cpp src/Names/SpeciesNames.cpp \
	src/Names/NatureNames.cpp src/Names/AbilityNames.cpp \
	src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp
GEN3_LEGALITY_CONTEXT_FLAGS := -Wno-unused-parameter
LEGACY_LEGALITY_CONTEXT_SOURCES := tests/test_legality_legacy_move_context.cpp \
	$(filter-out tests/test_gen3_legality_context.cpp,$(GEN3_LEGALITY_CONTEXT_SOURCES))
GEN1_STAGED_INVENTORY_LINK_SOURCES := src/Integration/Gen1/Gen1StagedInventoryEditor.cpp \
	$(CLASSIC_INVENTORY_CATALOG_LINK_SOURCES)
CLASSIC_UI_MODEL_SOURCES := tests/test_classic_inventory_ui_model.cpp \
	src/UI/ClassicInventoryUIModel.cpp $(CLASSIC_INVENTORY_CATALOG_LINK_SOURCES) src/Names/ItemNames.cpp

LEGACY_FRLG_BROWSE_SOURCES := tests/test_legacy_frlg_browse.cpp \
	src/Legacy/FRLGSourceBrowser.cpp src/Legacy/FRLGReadOnlyTrainer.cpp \
	src/Legacy/LegacySourceBindings.cpp \
	src/Integration/Gen3/PKSMGen3NativeAdapter.cpp src/Integration/Gen3/FRLGReadModel.cpp \
	src/Pokemon/Pokemon3FRLG.cpp \
	src/Pokemon/BaseStatsGen89.cpp src/Pokemon/PersonalInfoTable.cpp \
	src/Pokemon/Experience.cpp src/Encryption/Encryption3FRLG.cpp \
	src/Names/ItemNames.cpp src/Names/SpeciesNames.cpp src/Names/NatureNames.cpp \
	src/Names/AbilityNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp \
	src/Games/GameIdentity.cpp $(GEN3_STAGED_INVENTORY_LINK_SOURCES) \
	$(GEN3_STAGED_POKEMON_LINK_SOURCES)
LEGACY_FRLG_BROWSE_FLAGS := -Wno-unused-parameter
RSE_TEST_COMMON_SOURCES := tests/test_rse_gen3_adapter.cpp \
	src/Legacy/RetroArchFRLGDiscovery.cpp $(RBY_RUNTIME_DISCOVERY_SOURCES) \
	src/Integration/Gen3/FRLGReadModel.cpp \
	src/Encryption/Encryption3FRLG.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp \
	src/Utils/SHA256.cpp src/Games/GameIdentity.cpp
RSE_HOST_SOURCES := $(RSE_TEST_COMMON_SOURCES) src/Integration/Gen3/PKSMGen3Adapter.cpp
RSE_NATIVE_SOURCES := $(RSE_TEST_COMMON_SOURCES) src/Integration/Gen3/PKSMGen3NativeAdapter.cpp \
	src/Names/ItemNames.cpp

GEN1_ADAPTER_SOURCES := tests/test_rby_gen1_adapter.cpp \
	src/Integration/Gen1/Gen1ReadOnlySave.cpp
RBY_INVENTORY_SOURCES := tests/test_rby_inventory.cpp \
	src/Integration/Gen1/Gen1ReadOnlyInventory.cpp src/Names/ItemNames.cpp
RBY_DISCOVERY_SOURCES := tests/test_rby_discovery.cpp \
	src/Legacy/RetroArchRBYDiscovery.cpp src/Integration/Gen1/Gen1ReadOnlySave.cpp \
	src/Utils/SHA256.cpp
RBY_SOURCE_BROWSER_SOURCES := tests/test_rby_source_browser.cpp \
	src/Legacy/RBYSourceBrowser.cpp src/Legacy/RetroArchRBYDiscovery.cpp \
	src/Legacy/LegacySourceBindings.cpp src/Integration/Gen1/Gen1ReadOnlySave.cpp \
	src/Utils/SHA256.cpp src/Games/GameIdentity.cpp
RBY_BRIDGE_SOURCES := tests/test_rby_readonly_bridge.cpp \
	src/Legacy/RBYReadOnlyTrainer.cpp src/Pokemon/Pokemon1ReadOnly.cpp \
	src/Integration/Gen1/Gen1ReadOnlySave.cpp src/Integration/Gen1/Gen1ReadOnlyInventory.cpp \
	src/Pokemon/BaseStatsGen89.cpp \
	src/Names/SpeciesNames.cpp src/Names/ItemNames.cpp src/Names/NatureNames.cpp \
	src/Names/AbilityNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp \
	$(GEN1_STAGED_INVENTORY_LINK_SOURCES)
RBY_BRIDGE_FLAGS := -Wno-unused-parameter

GEN3_FIXTURE := $(HOST_BUILD)/frlg_fixture.sav
PKSM_CORE_OBJECT := $(HOST_BUILD)/pksm-core.o
PKSM_CORE_SANITIZE_OBJECT := $(HOST_BUILD)/pksm-core-sanitize.o
HOST_TESTS += $(HOST_BUILD)/test_pksm_gen3_adapter
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_pksm_gen3_adapter_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_native_slice
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_native_slice_sanitize
HOST_TESTS += $(HOST_BUILD)/test_retroarch_frlg_discovery
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_retroarch_frlg_discovery_sanitize
HOST_TESTS += $(HOST_BUILD)/test_legacy_frlg_browse
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legacy_frlg_browse_sanitize
HOST_TESTS += $(HOST_BUILD)/test_legacy_source_bindings
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legacy_source_bindings_sanitize
HOST_TESTS += $(HOST_BUILD)/test_rse_gen3_adapter $(HOST_BUILD)/test_rse_gen3_native_slice
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_rse_gen3_adapter_sanitize $(HOST_BUILD)/test_rse_gen3_native_slice_sanitize
HOST_TESTS += $(HOST_BUILD)/test_rby_gen1_adapter $(HOST_BUILD)/test_rby_inventory \
	$(HOST_BUILD)/test_rby_discovery $(HOST_BUILD)/test_rby_source_browser \
	$(HOST_BUILD)/test_rby_readonly_bridge
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_rby_gen1_adapter_sanitize \
	$(HOST_BUILD)/test_rby_inventory_sanitize $(HOST_BUILD)/test_rby_discovery_sanitize \
	$(HOST_BUILD)/test_rby_source_browser_sanitize $(HOST_BUILD)/test_rby_readonly_bridge_sanitize
HOST_TESTS += $(HOST_BUILD)/test_classic_inventory_ui_model $(HOST_BUILD)/test_inventory_ui_contract
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_classic_inventory_ui_model_sanitize $(HOST_BUILD)/test_inventory_ui_contract_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_legality_context
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_legality_context_sanitize
HOST_TESTS += $(HOST_BUILD)/test_legality_context_model
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_context_model_sanitize
HOST_TESTS += $(HOST_BUILD)/test_legality_legacy_move_context
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_legacy_move_context_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_wild_encounter_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_wild_encounter_evidence_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_static_encounter_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_static_encounter_evidence_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_trade_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_trade_evidence_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen1_catch_rate_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen1_catch_rate_evidence_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen1_encounter_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen1_encounter_evidence_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_pid_iv_correlation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_pid_iv_correlation_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_bacd_pid_iv_correlation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_bacd_pid_iv_correlation_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_channel_pid_iv_correlation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_channel_pid_iv_correlation_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen3_cxd_pid_iv_correlation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen3_cxd_pid_iv_correlation_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_pid_iv_correlation
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_pid_iv_correlation_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_pokewalker_pid
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_pokewalker_pid_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_cute_charm_pid
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_cute_charm_pid_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_chain_shiny
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_chain_shiny_sanitize
HOST_TESTS += $(HOST_BUILD)/test_gen4_mystery_gift_pid
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_mystery_gift_pid_sanitize

.PHONY: host-test host-sanitize host-clean

host-test: $(HOST_TESTS)
	@set -e; for test_bin in $(HOST_TESTS); do ./$$test_bin; done

host-sanitize: $(HOST_SANITIZE_TESTS)
	# LeakSanitizer cannot inspect /proc under the managed build sandbox. AddressSanitizer and
	# UndefinedBehaviorSanitizer still run; leak checks remain enabled in unrestricted CI builds.
	@set -e; for test_bin in $(HOST_SANITIZE_TESTS); do ASAN_OPTIONS=detect_leaks=0 ./$$test_bin; done

$(HOST_BUILD)/test_classic_inventory_ui_model: $(CLASSIC_UI_MODEL_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $^ -o $@

$(HOST_BUILD)/test_classic_inventory_ui_model_sanitize: $(CLASSIC_UI_MODEL_SOURCES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $^ -o $@

$(HOST_BUILD)/test_inventory_ui_contract: tests/test_inventory_ui_contract.cpp include/UI/InventoryUIContract.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude tests/test_inventory_ui_contract.cpp -o $@

$(HOST_BUILD)/test_inventory_ui_contract_sanitize: tests/test_inventory_ui_contract.cpp include/UI/InventoryUIContract.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_inventory_ui_contract.cpp -o $@

