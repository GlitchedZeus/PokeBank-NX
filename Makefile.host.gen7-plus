# Gen VII (Sun/Moon, Ultra Sun/Ultra Moon) adapter of the shared Modern::NativeSession contract
# (development/gen6-plus). Built with the Gen VII lane flags and the vendored FlagBrew/memecrypto
# objects that Makefile.host.gen7 defines (GEN7_FLAGS, GEN7_HEADERS, GEN7_MEME_*; that fragment is
# included earlier by Makefile.host). Host tests only; SAV7 export stays Blocked, so nothing built
# here can publish a working copy, let alone write an original save.
GEN7PLUS_TEST_NAMES := test_gen7_native_session
GEN7PLUS_TESTS := $(addprefix $(HOST_BUILD)/,$(GEN7PLUS_TEST_NAMES))
GEN7PLUS_SANITIZE_TESTS := $(addsuffix _sanitize,$(GEN7PLUS_TESTS))

HOST_TESTS += $(GEN7PLUS_TESTS)
HOST_SANITIZE_TESTS += $(GEN7PLUS_SANITIZE_TESTS)
host-test: $(GEN7PLUS_TESTS)
host-sanitize: $(GEN7PLUS_SANITIZE_TESTS)

GEN7PLUS_HEADERS := $(GEN7_HEADERS) include/Integration/Common/GameCapabilityRegistry.h \
	include/Integration/Common/VerifiedStagedExport.h include/Integration/Modern/NativeSession.h \
	include/Pokemon/ModernRecordView.h include/UI/ExactFormatEditorProvider.h \
	include/UI/SharedPokemonEditorContract.h include/Trainer/Inventory.h
GEN7PLUS_FLAGS := $(GEN7_FLAGS)

# Same link set as the Gen VI adapter test (Makefile.host.gen6-plus) with the Gen VII lane sources
# in place of the Gen VI ones; VerifiedStagedExport.cpp is not linked because no Gen VII export exists.
GEN7PLUS_SESSION_SOURCES := src/Integration/Gen7/Gen7NativeSession.cpp src/Integration/Gen7/Gen7Save.cpp \
	src/Integration/Gen7/Gen7StagedSession.cpp src/Utils/SHA256.cpp src/Pokemon/Experience.cpp \
	src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp src/Pokemon/PokemonTypes.cpp \
	src/Pokemon/PersonalInfoTable.cpp src/Names/SpeciesNames.cpp src/Games/GameIdentity.cpp
GEN7PLUS_SOURCES_test_gen7_native_session := tests/test_gen7_native_session.cpp $(GEN7PLUS_SESSION_SOURCES)

define GEN7PLUS_TEST_RULES
$(HOST_BUILD)/$(1): $$(GEN7PLUS_SOURCES_$(1)) $$(GEN7PLUS_HEADERS) $$(GEN7_MEME_OBJECTS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(GEN7PLUS_FLAGS) $$(GEN7PLUS_SOURCES_$(1)) $$(GEN7_MEME_OBJECTS) -o $$@

$(HOST_BUILD)/$(1)_sanitize: $$(GEN7PLUS_SOURCES_$(1)) $$(GEN7PLUS_HEADERS) $$(GEN7_MEME_SANITIZE_OBJECTS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(SANITIZE_FLAGS) $$(GEN7PLUS_FLAGS) $$(GEN7PLUS_SOURCES_$(1)) $$(GEN7_MEME_SANITIZE_OBJECTS) -o $$@
endef
$(foreach t,$(GEN7PLUS_TEST_NAMES),$(eval $(call GEN7PLUS_TEST_RULES,$(t))))

.PHONY: gen7plus-host-test gen7plus-host-sanitize
gen7plus-host-test: $(GEN7PLUS_TESTS)
	@set -e; for test_bin in $(GEN7PLUS_TESTS); do ./$$test_bin; done

gen7plus-host-sanitize: $(GEN7PLUS_SANITIZE_TESTS)
	@set -e; for test_bin in $(GEN7PLUS_SANITIZE_TESTS); do ASAN_OPTIONS="$(ASAN_OPTIONS)" ./$$test_bin; done

# MiniGmpAllocationScope invariants (nesting, hook restore, overflow, threads) over the real
# vendored MemeCrypto objects; the sanitizer build is the leak proof (CI sets detect_leaks=1).
MINIGMP_TEST := $(HOST_BUILD)/test_mini_gmp_scope
MINIGMP_SANITIZE := $(HOST_BUILD)/test_mini_gmp_scope_sanitize
HOST_TESTS += $(MINIGMP_TEST)
HOST_SANITIZE_TESTS += $(MINIGMP_SANITIZE)
host-test: $(MINIGMP_TEST)
host-sanitize: $(MINIGMP_SANITIZE)
$(MINIGMP_TEST): tests/test_mini_gmp_scope.cpp include/Integration/Gen7/MiniGmpAllocationScope.h $(GEN7_MEME_OBJECTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN7PLUS_FLAGS) -pthread tests/test_mini_gmp_scope.cpp $(GEN7_MEME_OBJECTS) -o $@
$(MINIGMP_SANITIZE): tests/test_mini_gmp_scope.cpp include/Integration/Gen7/MiniGmpAllocationScope.h $(GEN7_MEME_SANITIZE_OBJECTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) $(GEN7PLUS_FLAGS) -pthread tests/test_mini_gmp_scope.cpp $(GEN7_MEME_SANITIZE_OBJECTS) -o $@
GEN7PLUS_TESTS += $(MINIGMP_TEST)
gen7plus-host-test: $(MINIGMP_TEST)
GEN7PLUS_SANITIZE_TESTS += $(MINIGMP_SANITIZE)
gen7plus-host-sanitize: $(MINIGMP_SANITIZE)
