# Gen V (Black/White/Black 2/White 2) PK5 legality: PKHeX-backed fixtures, malformed
# records and a deterministic fuzz pass. tools/pkhex_gen5_diff/run.sh reproduces the
# fixture verdicts at scale against PKHeX.Core. A Gen III/IV-origin (Poke Transfer) record's
# original encounter is checked by the Gen IV analyzer (Gen4::analyzeOrigin5), so the Gen IV
# legality sources are part of the Gen V analyzer. A Colosseum/XD origin is judged by the Gen III
# GameCube judge (Gen3Cxd), so the Gen III analyzer sources are as well.
GEN5_GEN4_ORIGIN_SOURCES := src/Legality/Gen4Legality.cpp src/Legality/Gen4LegalityData.cpp \
	src/Legality/Gen4LegalityEncounters.cpp src/Legality/Gen4LegalityMoves.cpp src/Legality/Gen4LegalityPalPark.cpp \
	src/Legality/Gen4LegalityRng.cpp src/Legality/Gen4LegalityText.cpp \
	src/Legality/Gen3Legality.cpp src/Legality/Gen3LegalityData.cpp src/Legality/Gen3LegalityDataCxd.cpp
# Gen3Legality.cpp includes Pokemon/Pokemon.h, whose default virtuals leave parameters unused.
GEN5_LEGALITY_FLAGS := -Wno-unused-parameter
GEN5_LEGALITY_SOURCES := tests/test_legality_gen5.cpp src/Legality/Gen5Legality.cpp \
	src/Legality/Gen5LegalityData.cpp src/Legality/Gen5Text.cpp src/Names/SpeciesNames.cpp src/Names/MoveNames.cpp \
	src/Pokemon/Experience.cpp $(GEN5_GEN4_ORIGIN_SOURCES)
HOST_TESTS += $(HOST_BUILD)/test_legality_gen5
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_gen5_sanitize
host-test: $(HOST_BUILD)/test_legality_gen5
host-sanitize: $(HOST_BUILD)/test_legality_gen5_sanitize

GEN5_FULL_CARD_HEADERS := include/Legality/Gen5FullWonderCard.h include/Legality/Gen5FullCardCatalog.h
GEN5_ORIGIN_HEADERS := src/Legality/Gen4LegalityInternal.h include/Legality/Gen4Legality.h include/Legality/Gen4LegalityData.h

# Shared Gen IV terrain verification also applies to origins retained in a PK5.
GEN4_GROUND_TILE_SOURCES := tests/test_gen4_ground_tile.cpp $(filter-out tests/test_legality_gen5.cpp,$(GEN5_LEGALITY_SOURCES))
GEN4_GROUND_TILE_HEADERS := $(GEN5_ORIGIN_HEADERS) $(GEN5_FULL_CARD_HEADERS)
HOST_TESTS += $(HOST_BUILD)/test_gen4_ground_tile
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_ground_tile_sanitize
host-test: $(HOST_BUILD)/test_gen4_ground_tile
host-sanitize: $(HOST_BUILD)/test_gen4_ground_tile_sanitize
$(HOST_BUILD)/test_gen4_ground_tile: $(GEN4_GROUND_TILE_SOURCES) $(GEN4_GROUND_TILE_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) -Iinclude $(GEN4_GROUND_TILE_SOURCES) -o $@
$(HOST_BUILD)/test_gen4_ground_tile_sanitize: $(GEN4_GROUND_TILE_SOURCES) $(GEN4_GROUND_TILE_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN4_GROUND_TILE_SOURCES) -o $@

$(HOST_BUILD)/test_legality_gen5: $(GEN5_LEGALITY_SOURCES) $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) -Iinclude $(GEN5_LEGALITY_SOURCES) -o $@

$(HOST_BUILD)/test_legality_gen5_sanitize: $(GEN5_LEGALITY_SOURCES) $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN5_LEGALITY_SOURCES) -o $@

# App adapter (include/Legality/Gen5AppAdapter.h): raw PK5 bytes + the app's source game id.
GEN5_ADAPTER_SOURCES := tests/test_legality_gen5_adapter.cpp src/Legality/Gen5AppAdapter.cpp \
	src/Legality/Gen5Legality.cpp src/Legality/Gen5LegalityData.cpp src/Legality/Gen5Text.cpp \
	src/Names/SpeciesNames.cpp src/Names/MoveNames.cpp src/Pokemon/Experience.cpp $(GEN5_GEN4_ORIGIN_SOURCES)
HOST_TESTS += $(HOST_BUILD)/test_legality_gen5_adapter
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_gen5_adapter_sanitize
host-test: $(HOST_BUILD)/test_legality_gen5_adapter
host-sanitize: $(HOST_BUILD)/test_legality_gen5_adapter_sanitize

$(HOST_BUILD)/test_legality_gen5_adapter: $(GEN5_ADAPTER_SOURCES) include/Legality/Gen5AppAdapter.h $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) -Iinclude $(GEN5_ADAPTER_SOURCES) -o $@

$(HOST_BUILD)/test_legality_gen5_adapter_sanitize: $(GEN5_ADAPTER_SOURCES) include/Legality/Gen5AppAdapter.h $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN5_ADAPTER_SOURCES) -o $@

GEN5_GIFT_RECEIPT_SOURCES := tests/test_gen5_gift_receivability.cpp $(filter-out tests/test_legality_gen5.cpp,$(GEN5_LEGALITY_SOURCES))
HOST_TESTS += $(HOST_BUILD)/test_gen5_gift_receivability
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen5_gift_receivability_sanitize
host-test: $(HOST_BUILD)/test_gen5_gift_receivability
host-sanitize: $(HOST_BUILD)/test_gen5_gift_receivability_sanitize
$(HOST_BUILD)/test_gen5_gift_receivability: $(GEN5_GIFT_RECEIPT_SOURCES) include/Legality/Gen5GiftReceivability.h $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) -Iinclude $(GEN5_GIFT_RECEIPT_SOURCES) -o $@
$(HOST_BUILD)/test_gen5_gift_receivability_sanitize: $(GEN5_GIFT_RECEIPT_SOURCES) include/Legality/Gen5GiftReceivability.h $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN5_GIFT_RECEIPT_SOURCES) -o $@

