# Gen V (Black/White/Black 2/White 2) PK5 legality: PKHeX-backed fixtures, malformed
# records and a deterministic fuzz pass. tools/pkhex_gen5_diff/run.sh reproduces the
# fixture verdicts at scale against PKHeX.Core. A Gen III/IV-origin (Poke Transfer) record's
# original encounter is checked by the Gen IV analyzer (Gen4::analyzeOrigin5), so the Gen IV
# legality sources are part of the Gen V analyzer. A Colosseum/XD origin is judged by the Gen III
# GameCube judge (Gen3Cxd), so the Gen III analyzer sources are as well.
GEN5_GEN4_ORIGIN_SOURCES := src/Legality/Gen4Legality.cpp src/Legality/Gen4LegalityData.cpp \
	src/Legality/Gen4LegalityEncounters.cpp src/Legality/Gen4LegalityMoves.cpp src/Legality/Gen4LegalityPalPark.cpp \
	src/Legality/Gen4LegalityRng.cpp src/Legality/Gen4LegalityText.cpp \
	src/Legality/Gen3Legality.cpp src/Legality/Gen3LegalityData.cpp src/Legality/Gen3LegalityDataCxd.cpp
# Gen3Legality.cpp includes Pokemon/Pokemon.h, whose default virtuals leave parameters unused.
GEN5_LEGALITY_FLAGS := -Wno-unused-parameter
GEN5_LEGALITY_SOURCES := tests/test_legality_gen5.cpp src/Legality/Gen5Legality.cpp \
	src/Legality/Gen35BreedingAncestry.cpp \
	src/Legality/Gen5LegalityData.cpp src/Legality/Gen5Text.cpp src/Names/SpeciesNames.cpp src/Names/MoveNames.cpp \
	src/Pokemon/Experience.cpp $(GEN5_GEN4_ORIGIN_SOURCES)
HOST_TESTS += $(HOST_BUILD)/test_legality_gen5
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_gen5_sanitize
host-test: $(HOST_BUILD)/test_legality_gen5
host-sanitize: $(HOST_BUILD)/test_legality_gen5_sanitize

GEN5_FULL_CARD_HEADERS := include/Legality/Gen5FullWonderCard.h include/Legality/Gen5FullCardCatalog.h include/Legality/Gen5GlobalLinkCatalog.h
GEN5_ORIGIN_HEADERS := src/Legality/Gen4LegalityInternal.h include/Legality/Gen4Legality.h include/Legality/Gen4LegalityData.h include/Legality/Gen4RanchIV.h \
	include/Legality/Gen35BreedingAncestry.h include/Legality/FiniteBreedingChain.h include/Legality/BreedingBirthMoves.h include/Legality/CoverageMerge.h

GEN5_JOINT_BREEDING_SOURCES := tests/test_gen5_joint_breeding.cpp $(filter-out tests/test_legality_gen5.cpp,$(GEN5_LEGALITY_SOURCES))
HOST_TESTS += $(HOST_BUILD)/test_gen5_joint_breeding
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen5_joint_breeding_sanitize
host-test: $(HOST_BUILD)/test_gen5_joint_breeding
host-sanitize: $(HOST_BUILD)/test_gen5_joint_breeding_sanitize
$(HOST_BUILD)/test_gen5_joint_breeding: tests/fixtures/gen15_session2/gen5_bw_paired_family.txt tests/fixtures/gen15_session2/gen5_recursive_tangela.txt $(GEN5_JOINT_BREEDING_SOURCES) $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) -Iinclude $(GEN5_JOINT_BREEDING_SOURCES) -o $@
$(HOST_BUILD)/test_gen5_joint_breeding_sanitize: tests/fixtures/gen15_session2/gen5_bw_paired_family.txt tests/fixtures/gen15_session2/gen5_recursive_tangela.txt $(GEN5_JOINT_BREEDING_SOURCES) $(GEN5_FULL_CARD_HEADERS) $(GEN5_ORIGIN_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN5_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN5_JOINT_BREEDING_SOURCES) -o $@

