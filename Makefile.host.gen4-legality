# Gen IV (Diamond/Pearl/Platinum/HeartGold/SoulSilver) PK4 legality: PKHeX-backed fixtures,
# one negative per rule, malformed records, the Legality::analyze hook and a deterministic
# fuzz pass. tools/pkhex_gen34_diff/run.sh reproduces the fixture verdicts at scale against
# PKHeX.Core; tests/fuzz/fuzz_legality_gen4.cpp is the libFuzzer harness.
GEN4_LEGALITY_SOURCES := tests/test_legality_gen4.cpp \
	$(filter-out tests/test_gen3_legality_context.cpp,$(GEN3_LEGALITY_CONTEXT_SOURCES)) \
	src/Pokemon/Pokemon4ReadOnly.cpp src/Pokemon/Pokemon4ReadOnlyView.cpp \
	src/Encryption/Encryption4.cpp
GEN4_LEGALITY_HEADERS := include/Legality/Gen4Legality.h include/Legality/Gen4LegalityData.h \
	src/Legality/Gen4LegalityInternal.h include/Legality/Legality.h
# Pokemon.h has unused parameters (as for every Legality::analyze test). Under Clang, two
# shared PK3 sources also trip -Wunused-function and GCC-only pragmas; the Gen IV sources
# and this test are warning-free under both compilers without these.
GEN4_LEGALITY_FLAGS := $(GEN3_LEGALITY_CONTEXT_FLAGS) \
	$(if $(findstring clang,$(CXX)),-Wno-unused-function -Wno-unknown-warning-option)
HOST_TESTS += $(HOST_BUILD)/test_legality_gen4
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_legality_gen4_sanitize
host-test: $(HOST_BUILD)/test_legality_gen4
host-sanitize: $(HOST_BUILD)/test_legality_gen4_sanitize

$(HOST_BUILD)/test_legality_gen4: $(GEN4_LEGALITY_SOURCES) $(GEN4_LEGALITY_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN4_LEGALITY_FLAGS) -Iinclude $(GEN4_LEGALITY_SOURCES) -o $@

$(HOST_BUILD)/test_legality_gen4_sanitize: $(GEN4_LEGALITY_SOURCES) $(GEN4_LEGALITY_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(GEN4_LEGALITY_FLAGS) $(SANITIZE_FLAGS) -Iinclude $(GEN4_LEGALITY_SOURCES) -o $@

# libFuzzer harness (Clang only; not part of host-test): build/fuzz/fuzz_legality_gen4 CORPUS_DIR
GEN4_FUZZ_SOURCES := tests/fuzz/fuzz_legality_gen4.cpp $(filter-out tests/test_legality_gen4.cpp,$(GEN4_LEGALITY_SOURCES))
GEN4_FUZZ_FLAGS := -std=c++20 -g -O1 -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=undefined

$(HOST_BUILD)/fuzz_legality_gen4: $(GEN4_FUZZ_SOURCES) $(GEN4_LEGALITY_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(GEN4_FUZZ_FLAGS) $(GEN4_LEGALITY_FLAGS) -Iinclude $(GEN4_FUZZ_SOURCES) -o $@
