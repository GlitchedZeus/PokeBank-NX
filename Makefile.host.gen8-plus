# Sword/Shield (Generation VIII) adapter of the shared Modern::NativeSession contract
# (development/gen6-plus): Gen8StagedSession (staged Edit/Clone/Remove with battle-team protection
# and a canonical SwishCrypto re-encryption verifier) behind Gen8NativeSession. Host tests only;
# exports go to a fresh temporary directory, never to a source or installed save.
GEN8PLUS_TEST_NAMES := test_gen8_native_session
GEN8PLUS_TESTS := $(addprefix $(HOST_BUILD)/,$(GEN8PLUS_TEST_NAMES))
GEN8PLUS_SANITIZE_TESTS := $(addsuffix _sanitize,$(GEN8PLUS_TESTS))

HOST_TESTS += $(GEN8PLUS_TESTS)
HOST_SANITIZE_TESTS += $(GEN8PLUS_SANITIZE_TESTS)
host-test: $(GEN8PLUS_TESTS)
host-sanitize: $(GEN8PLUS_SANITIZE_TESTS)

GEN8PLUS_HEADERS := $(wildcard include/Integration/Gen8/*.h) $(wildcard tests/fixtures/gen8/*.h) \
	include/Integration/Common/GameCapabilityRegistry.h include/Integration/Common/VerifiedStagedExport.h \
	include/Integration/Modern/NativeSession.h include/UI/ExactFormatEditorProvider.h \
	include/UI/SharedPokemonEditorContract.h include/Trainer/Inventory.h include/Enums/Ball.h
GEN8PLUS_FLAGS := -Wno-unused-parameter -Iinclude -Itests -D_PKSMCORE_CONFIGURED -fno-operator-names

GEN8PLUS_SESSION_SOURCES := src/Integration/Gen8/Gen8NativeSession.cpp src/Integration/Gen8/Gen8StagedSession.cpp \
	src/Integration/Gen8/Gen8Save.cpp src/Integration/Gen8/Gen8SwishCrypto.cpp \
	src/Integration/Common/VerifiedStagedExport.cpp src/Utils/SHA256.cpp src/Utils/StringHelpers.cpp \
	src/Utils/HelperUtilities.cpp src/Pokemon/PokemonTypes.cpp src/Pokemon/PersonalInfoTable.cpp \
	src/Names/ItemPresence.cpp
GEN8PLUS_SOURCES_test_gen8_native_session := tests/test_gen8_native_session.cpp $(GEN8PLUS_SESSION_SOURCES)

define GEN8PLUS_TEST_RULES
$(HOST_BUILD)/$(1): $$(GEN8PLUS_SOURCES_$(1)) $$(GEN8PLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(GEN8PLUS_FLAGS) $$(GEN8PLUS_SOURCES_$(1)) -o $$@

$(HOST_BUILD)/$(1)_sanitize: $$(GEN8PLUS_SOURCES_$(1)) $$(GEN8PLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(SANITIZE_FLAGS) $$(GEN8PLUS_FLAGS) $$(GEN8PLUS_SOURCES_$(1)) -o $$@
endef
$(foreach t,$(GEN8PLUS_TEST_NAMES),$(eval $(call GEN8PLUS_TEST_RULES,$(t))))

.PHONY: gen8plus-host-test gen8plus-host-sanitize
gen8plus-host-test: $(GEN8PLUS_TESTS)
	@set -e; for test_bin in $(GEN8PLUS_TESTS); do ./$$test_bin; done

gen8plus-host-sanitize: $(GEN8PLUS_SANITIZE_TESTS)
	@set -e; for test_bin in $(GEN8PLUS_SANITIZE_TESTS); do ASAN_OPTIONS="$(ASAN_OPTIONS)" ./$$test_bin; done
