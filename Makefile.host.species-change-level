# Round 13 owner decision 9: an existing Pokemon keeps its current level on a species change and
# its EXP is reconciled to the new species' growth rate (include/Pokemon/SpeciesChangeExperience.h),
# Gen I-V, box and Party, through each generation's real species-change path. Source lists reuse
# the species-change-moves lanes.
SPECIES_LEVEL_DEPS := include/Pokemon/SpeciesChangeExperience.h include/UI/SpeciesChangeLevelPolicy.h $(SPECIES_MOVES_DEPS)

SPECIES_LEVEL_TESTS := $(HOST_BUILD)/test_species_change_level_gen1 $(HOST_BUILD)/test_species_change_level_gen2 \
	$(HOST_BUILD)/test_species_change_level_gen3 $(HOST_BUILD)/test_species_change_level_gen4 \
	$(HOST_BUILD)/test_species_change_level_gen5
SPECIES_LEVEL_SANITIZE := $(addsuffix _sanitize,$(SPECIES_LEVEL_TESTS))
HOST_TESTS += $(SPECIES_LEVEL_TESTS)
HOST_SANITIZE_TESTS += $(SPECIES_LEVEL_SANITIZE)
host-test: $(SPECIES_LEVEL_TESTS)
host-sanitize: $(SPECIES_LEVEL_SANITIZE)

.PHONY: host-species-change-level
host-species-change-level: $(SPECIES_LEVEL_TESTS)
	@set -e; for t in $(SPECIES_LEVEL_TESTS); do $$t; done

SPECIES_LEVEL_GEN1_SOURCES := tests/test_species_change_level_gen1.cpp $(GEN1_POKEMON_COMMON)
SPECIES_LEVEL_GEN2_SOURCES := tests/test_species_change_level_gen2.cpp $(GEN2_STAGED_EDITOR_COMMON) \
	src/Integration/Gen2/Gen2MoveCompatibility.cpp src/Integration/Gen1/Gen1MoveCompatibility.cpp
SPECIES_LEVEL_GEN3_SOURCES := tests/test_species_change_level_gen3.cpp \
	$(filter-out tests/test_gen3_staged_pokemon_editor.cpp,$(GEN3_POKEMON_EDITOR_SOURCES))
SPECIES_LEVEL_GEN4_SOURCES := tests/test_species_change_level_gen4.cpp \
	$(filter-out tests/test_gen4_staged_pokemon_editor.cpp,$(GEN4_STAGED_EDITOR_SOURCES))
SPECIES_LEVEL_GEN5_SOURCES := tests/test_species_change_level_gen5.cpp src/Names/SpeciesNames.cpp \
	src/Names/LocationNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp

$(HOST_BUILD)/test_species_change_level_gen1: $(SPECIES_LEVEL_GEN1_SOURCES) $(SPECIES_LEVEL_DEPS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(SPECIES_LEVEL_GEN1_SOURCES) -o $@
$(HOST_BUILD)/test_species_change_level_gen1_sanitize: $(SPECIES_LEVEL_GEN1_SOURCES) $(SPECIES_LEVEL_DEPS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude $(SPECIES_LEVEL_GEN1_SOURCES) -o $@

$(HOST_BUILD)/test_species_change_level_gen2: $(SPECIES_LEVEL_GEN2_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen2PokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude -Itests $(SPECIES_LEVEL_GEN2_SOURCES) -o $@
$(HOST_BUILD)/test_species_change_level_gen2_sanitize: $(SPECIES_LEVEL_GEN2_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen2PokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude -Itests $(SPECIES_LEVEL_GEN2_SOURCES) -o $@

$(HOST_BUILD)/test_species_change_level_gen3: $(SPECIES_LEVEL_GEN3_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen3SharedPokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Wno-unused-parameter -DPOKEBANK_GEN3_SELECTIVE_PORT_TEST -Iinclude $(SPECIES_LEVEL_GEN3_SOURCES) -o $@
$(HOST_BUILD)/test_species_change_level_gen3_sanitize: $(SPECIES_LEVEL_GEN3_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen3SharedPokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -DPOKEBANK_GEN3_SELECTIVE_PORT_TEST -Iinclude $(SPECIES_LEVEL_GEN3_SOURCES) -o $@

$(HOST_BUILD)/test_species_change_level_gen4: $(SPECIES_LEVEL_GEN4_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen4SharedPokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Wno-unused-parameter -Iinclude $(SPECIES_LEVEL_GEN4_SOURCES) -o $@
$(HOST_BUILD)/test_species_change_level_gen4_sanitize: $(SPECIES_LEVEL_GEN4_SOURCES) $(SPECIES_LEVEL_DEPS) include/UI/Gen4SharedPokemonSession.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -Iinclude $(SPECIES_LEVEL_GEN4_SOURCES) -o $@

$(HOST_BUILD)/test_species_change_level_gen5: $(SPECIES_LEVEL_GEN5_SOURCES) $(SPECIES_LEVEL_DEPS) \
	include/Integration/Gen5/Gen5SharedScreenState.h include/Integration/Gen5/Gen5StagedPokemonRecord.h
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(SPECIES_LEVEL_GEN5_SOURCES) -o $@
