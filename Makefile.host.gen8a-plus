# Legends: Arceus (SAV8LA / PA8) adapter of the shared Modern::NativeSession contract
# (development/gen6-plus). Host tests only; exports go to a fresh temporary directory.
GEN8APLUS_TEST_NAMES := test_gen8a_native_session
GEN8APLUS_TESTS := $(addprefix $(HOST_BUILD)/,$(GEN8APLUS_TEST_NAMES))
GEN8APLUS_SANITIZE_TESTS := $(addsuffix _sanitize,$(GEN8APLUS_TESTS))

HOST_TESTS += $(GEN8APLUS_TESTS)
HOST_SANITIZE_TESTS += $(GEN8APLUS_SANITIZE_TESTS)
host-test: $(GEN8APLUS_TESTS)
host-sanitize: $(GEN8APLUS_SANITIZE_TESTS)

GEN8APLUS_HEADERS := $(wildcard include/Integration/Gen8a/*.h) $(wildcard include/Integration/Gen8/*.h) \
	$(wildcard tests/fixtures/gen8a/*.h) include/Integration/Common/GameCapabilityRegistry.h include/Integration/Modern/NativeSession.h
GEN8APLUS_FLAGS := -Wno-unused-parameter -Iinclude -Itests -D_PKSMCORE_CONFIGURED -fno-operator-names
GEN8APLUS_SESSION_SOURCES := src/Integration/Gen8a/Gen8aNativeSession.cpp src/Integration/Gen8a/Gen8aSession.cpp \
	src/Integration/Gen8/Gen8SwishCrypto.cpp src/Integration/Common/VerifiedStagedExport.cpp src/Utils/SHA256.cpp \
	src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp src/Pokemon/PokemonTypes.cpp src/Pokemon/PersonalInfoTable.cpp \
	src/Names/ItemPresence.cpp
GEN8APLUS_SOURCES_test_gen8a_native_session := tests/test_gen8a_native_session.cpp $(GEN8APLUS_SESSION_SOURCES)

define GEN8APLUS_TEST_RULES
$(HOST_BUILD)/$(1): $$(GEN8APLUS_SOURCES_$(1)) $$(GEN8APLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(GEN8APLUS_FLAGS) $$(GEN8APLUS_SOURCES_$(1)) -o $$@

$(HOST_BUILD)/$(1)_sanitize: $$(GEN8APLUS_SOURCES_$(1)) $$(GEN8APLUS_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$$(CXX) $$(CXXFLAGS) $$(SANITIZE_FLAGS) $$(GEN8APLUS_FLAGS) $$(GEN8APLUS_SOURCES_$(1)) -o $$@
endef
$(foreach t,$(GEN8APLUS_TEST_NAMES),$(eval $(call GEN8APLUS_TEST_RULES,$(t))))

.PHONY: gen8aplus-host-test gen8aplus-host-sanitize
gen8aplus-host-test: $(GEN8APLUS_TESTS)
	@set -e; for test_bin in $(GEN8APLUS_TESTS); do ./$$test_bin; done

gen8aplus-host-sanitize: $(GEN8APLUS_SANITIZE_TESTS)
	@set -e; for test_bin in $(GEN8APLUS_SANITIZE_TESTS); do ASAN_OPTIONS="$(ASAN_OPTIONS)" ./$$test_bin; done
