# Gen V phase A: strictly read-only PK5 record foundation; no source writer.
GEN5_PK5_TEST := $(HOST_BUILD)/test_gen5_pk5_readonly
GEN5_PK5_SANITIZE := $(HOST_BUILD)/test_gen5_pk5_readonly_sanitize
GEN5_PK5_INPUTS := tests/test_gen5_pk5_readonly.cpp \
    include/Encryption/Encryption5.h include/Pokemon/Pokemon5ReadOnly.h

HOST_TESTS += $(GEN5_PK5_TEST)
HOST_SANITIZE_TESTS += $(GEN5_PK5_SANITIZE)
host-test: $(GEN5_PK5_TEST)
host-sanitize: $(GEN5_PK5_SANITIZE)

$(GEN5_PK5_TEST): $(GEN5_PK5_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude tests/test_gen5_pk5_readonly.cpp -o $@

$(GEN5_PK5_SANITIZE): $(GEN5_PK5_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_pk5_readonly.cpp -o $@

# Phase A tranche 2: strict BW/B2W2 battery save checksum & reader contracts.
GEN5_SAVE_TEST := $(HOST_BUILD)/test_gen5_readonly_save
GEN5_SAVE_SANITIZE := $(HOST_BUILD)/test_gen5_readonly_save_sanitize
GEN5_SAVE_INPUTS := tests/test_gen5_readonly_save.cpp \
    include/Integration/Gen5/Gen5SaveBlockLayout.h \
    include/Integration/Gen5/Gen5ReadOnlySave.h \
    include/Integration/Gen5/Gen5SaveInstanceAdapter.h \
    include/Pokemon/Pokemon5ReadOnly.h include/Encryption/Encryption5.h include/Utils/CRC16.h

HOST_TESTS += $(GEN5_SAVE_TEST)
HOST_SANITIZE_TESTS += $(GEN5_SAVE_SANITIZE)
host-test: $(GEN5_SAVE_TEST)
host-sanitize: $(GEN5_SAVE_SANITIZE)

$(GEN5_SAVE_TEST): $(GEN5_SAVE_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude tests/test_gen5_readonly_save.cpp -o $@

$(GEN5_SAVE_SANITIZE): $(GEN5_SAVE_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_readonly_save.cpp -o $@
