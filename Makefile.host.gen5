	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_box_touch.cpp -o $@

# The shared Gen I-IV Add flow's Gen V picker bounds are independently
# compiled and exercised, including language, calendar, Move and EV input.
GEN5_CREATE_INPUT_TEST := $(HOST_BUILD)/test_gen5_create_input_rules
GEN5_CREATE_INPUT_SANITIZE := $(HOST_BUILD)/test_gen5_create_input_rules_sanitize
GEN5_CREATE_INPUT_FILES := tests/test_gen5_create_input_rules.cpp include/Integration/Gen5/Gen5CreateInputRules.h
HOST_TESTS += $(GEN5_CREATE_INPUT_TEST)
HOST_SANITIZE_TESTS += $(GEN5_CREATE_INPUT_SANITIZE)
host-test: $(GEN5_CREATE_INPUT_TEST)
