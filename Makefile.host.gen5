# Gen V end-to-end source flow: copy choice -> assign -> reopen -> stage ->
# verified working-copy export; source immutable, stale source refused.
GEN5_E2E_TEST := $(HOST_BUILD)/test_gen5_source_e2e
GEN5_E2E_SANITIZE := $(HOST_BUILD)/test_gen5_source_e2e_sanitize
GEN5_E2E_SOURCES := tests/test_gen5_source_e2e.cpp src/Integration/Gen5/Gen5SourceDiscovery.cpp \
    src/Integration/Gen5/Gen5AssignedSource.cpp src/Integration/Gen5/Gen5WorkingCopyExport.cpp \
    src/Legacy/LegacySourceBindings.cpp src/Legacy/Gen5ReadOnlyTrainer.cpp src/Utils/SHA256.cpp \
    src/Games/GameIdentity.cpp src/Names/SpeciesNames.cpp
GEN5_E2E_INPUTS := $(GEN5_E2E_SOURCES) $(GEN5_TRAINER_INPUTS) $(GEN5_SAVE_INPUTS)

HOST_TESTS += $(GEN5_E2E_TEST)
HOST_SANITIZE_TESTS += $(GEN5_E2E_SANITIZE)
