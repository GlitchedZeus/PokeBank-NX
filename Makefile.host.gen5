$(GEN5_CREATE_INPUT_TEST): $(GEN5_CREATE_INPUT_FILES)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude tests/test_gen5_create_input_rules.cpp -o $@

