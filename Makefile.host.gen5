	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -Iinclude $(GEN5_BAG_SCREEN_SOURCES) -o $@

# Gen V Party/Box parity with the Gen IV shared editor (Move Pokemon,
# party actions, party stat regeneration, read-only origin fields).
