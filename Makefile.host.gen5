	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_create_input_rules.cpp -o $@

# Gen V PID-linked Gender / Shiny / Ability coordination (PKHeX 6501f0ab rules).
GEN5_PID_TEST := $(HOST_BUILD)/test_gen5_pid_coordination
GEN5_PID_SANITIZE := $(HOST_BUILD)/test_gen5_pid_coordination_sanitize
GEN5_PID_INPUTS := tests/test_gen5_pid_coordination.cpp include/Integration/Gen5/Gen5PidCoordination.h \
    include/Integration/Gen5/Gen5StagedPokemonRecord.h

HOST_TESTS += $(GEN5_PID_TEST)
HOST_SANITIZE_TESTS += $(GEN5_PID_SANITIZE)
host-test: $(GEN5_PID_TEST)
host-sanitize: $(GEN5_PID_SANITIZE)

$(GEN5_PID_TEST): $(GEN5_PID_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude tests/test_gen5_pid_coordination.cpp src/Names/SpeciesNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp -o $@

$(GEN5_PID_SANITIZE): $(GEN5_PID_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_pid_coordination.cpp src/Names/SpeciesNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp -o $@

# S04 owner hardware item: one end-to-end Gen V trace through the shared screen
# state (Create/Edit/Clone/Move/Release/Held Item/Bag -> Review -> cancel ->
# Discard All -> redo -> Export Copy -> reopen); source file byte-identical.
GEN5_S04_TRACE_TEST := $(HOST_BUILD)/test_gen5_review_discard_export_trace
GEN5_S04_TRACE_SANITIZE := $(HOST_BUILD)/test_gen5_review_discard_export_trace_sanitize
GEN5_S04_TRACE_SOURCES := tests/test_gen5_review_discard_export_trace.cpp \
    src/Integration/Gen5/Gen5SourceDiscovery.cpp src/Integration/Gen5/Gen5WorkingCopyExport.cpp \
    src/Legacy/Gen5ReadOnlyTrainer.cpp src/Utils/SHA256.cpp src/Games/GameIdentity.cpp \
    src/Names/SpeciesNames.cpp src/Utils/StringHelpers.cpp src/Utils/HelperUtilities.cpp
GEN5_S04_TRACE_INPUTS := $(GEN5_S04_TRACE_SOURCES) include/Integration/Gen5/Gen5BagScreen.h \
    include/Integration/Gen5/Gen5SourceDiscovery.h $(GEN5_TRAINER_INPUTS) $(GEN5_SAVE_INPUTS)

HOST_TESTS += $(GEN5_S04_TRACE_TEST)
HOST_SANITIZE_TESTS += $(GEN5_S04_TRACE_SANITIZE)
host-test: $(GEN5_S04_TRACE_TEST)
host-sanitize: $(GEN5_S04_TRACE_SANITIZE)

$(GEN5_S04_TRACE_TEST): $(GEN5_S04_TRACE_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Wno-unused-parameter -Iinclude $(GEN5_S04_TRACE_SOURCES) -o $@

$(GEN5_S04_TRACE_SANITIZE): $(GEN5_S04_TRACE_INPUTS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Wno-unused-parameter -Iinclude $(GEN5_S04_TRACE_SOURCES) -o $@

# Owner Round 4: Gen V Pokémon Language cycles in place on A/touch, not a modal picker.
