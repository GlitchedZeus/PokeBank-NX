	$(CXX) $(CXXFLAGS) $(SANITIZE_FLAGS) -Iinclude tests/test_gen5_bag.cpp src/Integration/Gen5/Gen5WorkingCopyExport.cpp src/Utils/SHA256.cpp -o $@

# Gen V Bag in the shared Items surface: host UI model (A/X/Y/L/R parity,
