	include/Legality/Gen4LeadFailureEvidence.h include/Legality/Gen4LeadEffectEvidence.h \
	include/Legality/Gen4LeadFrameEvidence.h
GEN4_LEAD_HISTORY_SOURCES := tests/test_gen4_lead_history_evidence.cpp
GEN4_LEAD_HISTORY_HEADERS := include/Legality/Gen4LeadHistoryEvidence.h \
	include/Legality/Gen4PressureLeadEvidence.h include/Legality/Gen4StaticMagnetLeadEvidence.h \
	include/Legality/Gen4LeadFailureEvidence.h include/Legality/Gen4LeadEffectEvidence.h \
	include/Legality/Gen4LeadFrameEvidence.h include/Legality/Gen4WildRngCorrelation.h
GEN4_MIN31_REROLL_SOURCES := tests/test_gen4_min31_reroll_frames.cpp
GEN4_MIN31_REROLL_HEADERS := include/Legality/Gen4LeadFrameEvidence.h \
	include/Legality/Gen4WildRngCorrelation.h
GEN4_LEAD_REPORTING_SOURCES := tests/test_gen4_lead_reporting_evidence.cpp
GEN4_LEAD_REPORTING_HEADERS := include/Legality/Gen4LeadReportingEvidence.h \
	include/Legality/Gen4LeadHistoryEvidence.h $(GEN4_LEAD_HISTORY_HEADERS)

HOST_TESTS += $(HOST_BUILD)/test_gen4_lead_effect_evidence \
	$(HOST_BUILD)/test_gen4_lead_failure_evidence \
	$(HOST_BUILD)/test_gen4_bcc_sync_failure_reroll \
	$(HOST_BUILD)/test_gen4_static_magnet_lead_evidence \
	$(HOST_BUILD)/test_gen4_pressure_lead_evidence \
	$(HOST_BUILD)/test_gen4_lead_history_evidence \
	$(HOST_BUILD)/test_gen4_min31_reroll_frames \
	$(HOST_BUILD)/test_gen4_lead_reporting_evidence
HOST_SANITIZE_TESTS += $(HOST_BUILD)/test_gen4_lead_effect_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_lead_failure_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_bcc_sync_failure_reroll_sanitize \
	$(HOST_BUILD)/test_gen4_static_magnet_lead_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_pressure_lead_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_lead_history_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_min31_reroll_frames_sanitize \
	$(HOST_BUILD)/test_gen4_lead_reporting_evidence_sanitize
host-test: $(HOST_BUILD)/test_gen4_lead_effect_evidence \
	$(HOST_BUILD)/test_gen4_lead_failure_evidence \
	$(HOST_BUILD)/test_gen4_bcc_sync_failure_reroll \
	$(HOST_BUILD)/test_gen4_static_magnet_lead_evidence \
	$(HOST_BUILD)/test_gen4_pressure_lead_evidence \
	$(HOST_BUILD)/test_gen4_lead_history_evidence \
	$(HOST_BUILD)/test_gen4_min31_reroll_frames \
	$(HOST_BUILD)/test_gen4_lead_reporting_evidence
host-sanitize: $(HOST_BUILD)/test_gen4_lead_effect_evidence_sanitize \
