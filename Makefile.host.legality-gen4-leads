	$(HOST_BUILD)/test_gen4_lead_history_evidence_sanitize \
	$(HOST_BUILD)/test_gen4_min31_reroll_frames_sanitize \
	$(HOST_BUILD)/test_gen4_lead_reporting_evidence_sanitize

$(HOST_BUILD)/test_gen4_lead_effect_evidence: $(GEN4_LEAD_EFFECT_SOURCES) $(GEN4_LEAD_EFFECT_HEADERS)
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(GEN4_LEAD_EFFECT_SOURCES) -o $@

