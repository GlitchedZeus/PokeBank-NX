# Focused Gen IV Method J/K lead-effect evidence regressions.
GEN4_LEAD_EFFECT_SOURCES := tests/test_gen4_lead_effect_evidence.cpp
GEN4_LEAD_EFFECT_HEADERS := include/Legality/Gen4LeadEffectEvidence.h
GEN4_LEAD_FAILURE_SOURCES := tests/test_gen4_lead_failure_evidence.cpp
