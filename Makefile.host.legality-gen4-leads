GEN4_BCC_SYNC_FAILURE_HEADERS := include/Legality/Gen4BugContestSynchronizeFailureEvidence.h \
	include/Legality/Gen4LeadFailureEvidence.h include/Legality/Gen4LeadEffectEvidence.h \
	include/Legality/Gen4LeadFrameEvidence.h include/Legality/Gen4WildEncounter.h
GEN4_STATIC_MAGNET_SOURCES := tests/test_gen4_static_magnet_lead_evidence.cpp
GEN4_STATIC_MAGNET_HEADERS := include/Legality/Gen4StaticMagnetLeadEvidence.h \
	include/Legality/Gen4LeadFailureEvidence.h include/Legality/Gen4LeadEffectEvidence.h \
	include/Legality/Gen4LeadFrameEvidence.h
